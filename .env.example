# Copy to `.env` and fill in. `.env` is git-ignored; this template is not,
# so never put a real key in here.

# --- DeepSeek (the default model backend) ---------------------------------
# Get one at https://platform.deepseek.com/api_keys — starts with "sk-".
DEEPSEEK_API_KEY=

# Optional. Both https://api.deepseek.com and .../v1 work.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat (V3, fast, supports tool calling) or deepseek-reasoner (R1).
DEEPSEEK_MODEL=deepseek-chat

# --- Anthropic (only needed for `--agent claude`) -------------------------
ANTHROPIC_API_KEY=
